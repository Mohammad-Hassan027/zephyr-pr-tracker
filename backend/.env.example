PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/zephyr
CLIENT_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
PR_ADMIN_PASSWORD=changeme
AUTH_SECRET=replace_with_a_long_random_secret

# from your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Create this as a signed Cloudinary preset with folder=zephyr-payments,
# resource_type=image, allowed_formats=jpg,jpeg,png,webp,
# max_file_size=5242880, and disallow_public_id=true.
CLOUDINARY_UPLOAD_PRESET=zephyr_payments_signed
