# Runtime environment: "development" | "production" | "test"
NODE_ENV=development

PORT=5000

MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/zephyr

CLIENT_ORIGIN=http://localhost:3000

# Alias used in email templates and redirects (should match CLIENT_ORIGIN).
CLIENT_URL=http://localhost:3000


# HMAC-SHA256 signing key for session tokens.
AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars

# Shared password for the platform super-admin console (/platform/clubs).
PLATFORM_ADMIN_PASSWORD=changeme_with_a_strong_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=zephyr_payments_signed

# EMAIL_PROVIDER controls how outbound emails are delivered:
#   "console"    — logs email content to stdout (default for local dev)
#   "mock"       — silently captures emails in memory (used by tests)
#   "smtp"       — sends via SMTP (requires SMTP_* variables below)
#   "nodemailer" — alias for "smtp"
#
# If EMAIL_PROVIDER is "console" or "mock", no SMTP vars are needed.
EMAIL_PROVIDER=console
EMAIL_FROM=Zephyr Events <noreply@zephyr.local>

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# Set to "true" for port 465 (implicit TLS). Usually "false" for port 587.
SMTP_SECURE=false
