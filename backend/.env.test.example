# backend/.env.test.example
#
# Safe, deterministic test-only environment values.
# Copy to .env.test if you need to override defaults set by
# tests/test-env-setup.js (loaded automatically via --import).
#
# DO NOT use real credentials here.
# DO NOT commit a real .env.test file.
#
# The test suite is fully hermetic:
#  - MongoDB is provided by mongodb-memory-server (no external instance needed).
#  - Email is captured by the "mock" provider (no SMTP server needed).
#  - Cloudinary is disabled (upload signature endpoint returns an error, which
#    is tested via the acceptance criteria: status 200 OR 500).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=0

# ── Auth (required, min 32 chars) ────────────────────────────────────────────
AUTH_SECRET=zephyr-test-secret-key-do-not-use-in-production-32+
PLATFORM_ADMIN_PASSWORD=test-platform-admin-pw

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Leave blank → setup-test-db.js will start MongoMemoryServer automatically.
# MONGO_URI=

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock
EMAIL_FROM=Zephyr Test <noreply@zephyr.test>

# ── Cloudinary (all blank = gracefully disabled in tests) ────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=
