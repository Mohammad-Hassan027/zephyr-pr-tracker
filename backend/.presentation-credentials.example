# Presentation & Demo Credentials Configuration Example
# Copy this file to backend/.presentation-credentials (or configure in .env / shell environment)
# NOTE: The actual .presentation-credentials file is ignored by git. Never commit real credentials.

# Club Admin Account Credentials
DEMO_CLUB_EMAIL=admin@zephyr-demo.example.com
DEMO_CLUB_PASSWORD=your_secure_presentation_password_here

# PR Team Member Default PIN (6 digits)
DEMO_PR_PIN=654321
