# ==============================================================================
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES (Vercel)
# ==============================================================================
# Production environment variables for Vercel deployment.
# Set these in the Vercel dashboard under Project → Settings → Environment Variables.
# NEVER commit real values — this file contains placeholders only.
#
# CANONICAL ARCHITECTURE:
#   Frontend (Vercel): Next.js App Router
#   Backend (Render): Node.js / Express (Canonical Blueprint: ../render.yaml)
# ==============================================================================

# Server-side variable: used by Next.js API route handlers (BFF proxy) to call
# the Render backend directly — server-to-server, not exposed to the browser.
# Example: https://zephyr-backend.onrender.com/api
BACKEND_API_URL=https://your-render-backend.onrender.com/api

# Public variable: used by client-side code to make API calls.
# Set to "/api" so the browser proxies all API calls through Next.js rewrites
# (defined in next.config.js → rewrites), which forward them to BACKEND_API_URL.
# This keeps the backend URL out of the client bundle and avoids CORS preflight
# issues for most endpoints.
NEXT_PUBLIC_API_URL=/api

# Public variable: canonical public URL of this Vercel deployment.
# Used for generating absolute links in emails, entry-pass QR codes, etc.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
