# frontend/.env.local.example
#
# Copy this file to .env.local for local development.
#   cp .env.local.example .env.local
#
# NEVER commit .env.local — it is excluded by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Server-side variable: used by Next.js API route handlers (BFF proxy) to call
# the backend directly. Not exposed to the browser.
BACKEND_API_URL=http://localhost:5000/api

# Public variable: used by client-side code to make API calls.
# In local dev this points directly to the running backend.
# In production this is typically "/api" (proxied through Next.js rewrites).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public variable: canonical URL of this frontend deployment.
# Used for generating absolute links in emails and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
